---
import ToolPage from './ToolPage.astro';
import Toolbar from './Toolbar.astro';
import EditorPane from './EditorPane.astro';
import ErrorPanel from './ErrorPanel.astro';
import OutputMeta from './OutputMeta.astro';
import StatsBar from './StatsBar.astro';
import SendMenu from './SendMenu.astro';
import ShortcutsDialog from './ShortcutsDialog.astro';
import type { Locale } from '../../i18n/config';
import type { ToolDef } from '../../tools/types';
import { t } from '../../i18n/t';
import { commonToolStrings } from '../../i18n/tool-strings';

interface Props {
  locale: Locale;
  tool: ToolDef;
  kind: 'minify' | 'repair';
}

const { locale, tool, kind } = Astro.props;
const action = kind;
const label = kind === 'minify' ? t(locale, 'tool.minify') : t(locale, 'tool.repair');
const outputPlaceholder =
  kind === 'minify'
    ? t(locale, 'tool.outputPlaceholder.minified')
    : t(locale, 'tool.outputPlaceholder.repaired');
const stats =
  kind === 'minify'
    ? [
        { key: 'size', label: t(locale, 'tool.stats.size') },
        { key: 'output', label: t(locale, 'tool.stats.output') },
        { key: 'saved', label: t(locale, 'tool.stats.saved') },
        { key: 'time', label: t(locale, 'tool.stats.time') },
      ]
    : [
        { key: 'size', label: t(locale, 'tool.stats.size') },
        { key: 'fixes', label: t(locale, 'tool.stats.fixes') },
        { key: 'lines', label: t(locale, 'tool.stats.lines') },
        { key: 'time', label: t(locale, 'tool.stats.time') },
      ];

const strings = {
  ...commonToolStrings(locale),
  largeRun: t(locale, 'tool.largeRunAction', { action: label }),
  largeLoaded: t(locale, 'tool.largeLoadedAction', { action: label }),
  largeWarning: t(locale, 'tool.largeWarningAction', { action: label }),
  minifying: t(locale, 'tool.minifying'),
  repairing: t(locale, 'tool.repairing'),
  minifyDone: t(locale, 'tool.minifyDone'),
  repairDone: t(locale, 'tool.repairDone'),
  minifiedMeta: t(locale, 'tool.minifiedMeta'),
  noFixes: t(locale, 'tool.noFixes'),
  fixesApplied: t(locale, 'tool.fixesApplied'),
  fixesAppliedOne: t(locale, 'tool.fixesApplied.one'),
  repairNotice: t(locale, 'tool.repairNotice'),
  repairNoticeOne: t(locale, 'tool.repairNotice.one'),
  reviewChanges: t(locale, 'tool.reviewChanges'),
  revertOriginal: t(locale, 'tool.revertOriginal'),
  repairAmbiguous: t(locale, 'tool.repairAmbiguous'),
  reviewTitle: t(locale, 'tool.reviewTitle'),
  diffOriginal: t(locale, 'tool.diffOriginal'),
  diffRepaired: t(locale, 'tool.diffRepaired'),
  outputLabel: t(locale, 'tool.output'),
  outputPlaceholder,
  fix: {
    comments: t(locale, 'tool.fix.comments'),
    trailingCommas: t(locale, 'tool.fix.trailingCommas'),
    singleQuotes: t(locale, 'tool.fix.singleQuotes'),
    smartQuotes: t(locale, 'tool.fix.smartQuotes'),
    unquotedKeys: t(locale, 'tool.fix.unquotedKeys'),
    pythonLiterals: t(locale, 'tool.fix.pythonLiterals'),
  },
};
---

<ToolPage locale={locale} tool={tool} strings={strings}>
  <div
    class="mt-5 overflow-hidden rounded-[16px] border border-line bg-canvas sm:mt-7"
    data-tool-frame
  >
    <Toolbar
      locale={locale}
      action={action}
      label={label}
      showIndent={kind === 'repair'}
      showFind={true}
      showFullscreen
    />

    <div
      class="flex items-center gap-1 border-b border-line px-2 md:hidden"
      role="tablist"
      aria-label={`${t(locale, 'tool.input')} / ${t(locale, 'tool.output')}`}
      data-mobile-tabs
    >
      <button
        type="button"
        id="tab-input"
        data-tab="input"
        role="tab"
        aria-selected="true"
        aria-controls="pane-input"
        tabindex="0"
        class="tool-tab"
      >
        {t(locale, 'tool.input')}
      </button>
      <button
        type="button"
        id="tab-output"
        data-tab="output"
        role="tab"
        aria-selected="false"
        aria-controls="pane-output"
        tabindex="-1"
        class="tool-tab"
      >
        {t(locale, 'tool.output')}
        <span class="ml-1 inline-block size-1.5 rounded-full bg-primary align-middle" data-output-dot hidden></span>
      </button>
    </div>

    <div class="tool-panes md:grid md:grid-cols-2" data-mobile-view="input">
      <section
        class="tool-pane is-active min-w-0 flex-col"
        data-pane="input"
        id="pane-input"
        role="tabpanel"
        aria-label={t(locale, 'tool.input')}
      >
        <div class="pane-head">
          <h2 class="whitespace-nowrap font-sans text-[12px] font-semibold uppercase leading-5 tracking-[0.08em] text-body-mid">
            {t(locale, 'tool.input')}
          </h2>
          <div class="flex items-center gap-2">
            <span
              data-file-chip
              hidden
              class="inline-flex max-w-[60%] items-center gap-1.5 rounded-full bg-cream px-2.5 py-1 font-mono text-[11px] leading-4 text-body"
            >
              <span data-file-name class="truncate" />
            </span>
            {kind === 'minify' && <SendMenu locale={locale} slug={tool.slug} />}
          </div>
        </div>

        <EditorPane
          kind="input"
          locale={locale}
          largeAction={`${kind}-large`}
          largeLabel={kind === 'minify' ? t(locale, 'tool.minifyFile') : t(locale, 'tool.repairFile')}
        >
        </EditorPane>
      </section>

      <section
        class="tool-pane min-w-0 flex-col md:border-l md:border-line"
        data-pane="output"
        id="pane-output"
        role="tabpanel"
        aria-label={t(locale, 'tool.output')}
      >
        <div class="pane-head">
          <h2 class="whitespace-nowrap font-sans text-[12px] font-semibold uppercase leading-5 tracking-[0.08em] text-body-mid">
            {t(locale, 'tool.output')}
          </h2>
          <div class="flex min-w-0 items-center gap-2">
            <OutputMeta locale={locale} variant={kind === 'repair' ? 'list' : 'text'} />
            {kind === 'repair' && <SendMenu locale={locale} slug={tool.slug} />}
          </div>
        </div>

        {kind === 'repair' && (
          <div data-repair-notice hidden aria-live="polite" class="border-b border-line bg-cream/60 px-3 py-2 text-[13px] text-body">
            <span data-repair-notice-text></span>
            <button type="button" data-action="review-repair" class="ml-2 font-semibold text-primary underline-offset-2 hover:underline">
              {t(locale, 'tool.reviewChanges')}
            </button>
          </div>
        )}
        <EditorPane kind="output" locale={locale}>
          <ErrorPanel locale={locale} canRepair={kind === 'minify'} />
        </EditorPane>
      </section>
    </div>

    <StatsBar locale={locale} stats={stats} />
  </div>
</ToolPage>

<ShortcutsDialog locale={locale} runLabel={label} />

{kind === 'repair' && (
  <dialog data-repair-dialog class="w-[min(720px,calc(100vw-2rem))] max-w-[calc(100vw-2rem)] max-h-[min(80vh,760px)] rounded-[16px] border border-line bg-canvas p-0 text-body shadow-2xl backdrop:bg-ink/40">
    <div class="flex items-center justify-between border-b border-line px-4 py-3">
      <h2 class="text-[15px] font-semibold text-ink">{t(locale, 'tool.reviewTitle')}</h2>
      <button type="button" data-action="close-review" class="min-h-11 min-w-11 rounded-md px-2 py-1 text-body-mid hover:text-ink" aria-label={t(locale, 'tool.close')}>✕</button>
    </div>
    <div class="min-h-0 flex-1 overflow-y-auto p-4">
      <section>
        <h3 class="mb-2 text-[12px] font-semibold uppercase tracking-[0.08em] text-body-mid">{t(locale, 'tool.stats.fixes')}</h3>
        <ul data-review-fixes class="space-y-1 text-[13px]"></ul>
      </section>
      <section class="mt-4">
        <h3 class="mb-2 text-[12px] font-semibold uppercase tracking-[0.08em] text-body-mid">{t(locale, 'tool.reviewDiff')}</h3>
        <div class="grid grid-cols-1 gap-2 text-[12px] sm:grid-cols-2">
          <div>
            <div class="mb-1 font-semibold text-body-mid">{t(locale, 'tool.diffOriginal')}</div>
            <pre data-review-left tabindex="0" class="max-h-64 overflow-auto rounded-md bg-cream p-2 font-mono"></pre>
          </div>
          <div>
            <div class="mb-1 font-semibold text-body-mid">{t(locale, 'tool.diffRepaired')}</div>
            <pre data-review-right tabindex="0" class="max-h-64 overflow-auto rounded-md bg-cream p-2 font-mono"></pre>
          </div>
        </div>
      </section>
    </div>
    <div class="flex justify-end gap-2 border-t border-line px-4 py-3">
      <button type="button" data-action="revert-repair" class="min-h-11 rounded-md border border-line px-3 py-1.5 text-[13px] hover:border-line-strong">{t(locale, 'tool.revertOriginal')}</button>
    </div>
  </dialog>
)}

<style>
  /* Tailwind preflight resets dialog margins, so center the modal explicitly. */
  dialog[data-repair-dialog] {
    position: fixed;
    inset: 0;
    margin: auto;
    overflow: hidden;
  }

  dialog[data-repair-dialog][open] {
    display: flex;
    flex-direction: column;
  }

  dialog[data-repair-dialog]::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  @media (max-width: 767px) {
    dialog[data-repair-dialog] {
      max-height: 92vh;
    }
  }

  .tool-tab {
    position: relative;
    display: inline-flex;
    height: 44px;
    align-items: center;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--body-mid);
  }

  .tool-tab[aria-selected="true"] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--primary);
  }

  @media (max-width: 767px) {
    .tool-pane {
      display: none;
    }

    .tool-pane.is-active {
      display: flex;
    }
  }
</style>
