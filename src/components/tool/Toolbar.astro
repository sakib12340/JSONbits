---
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
  action?: string;
  label?: string;
  showIndent?: boolean;
  showFind?: boolean;
  showCopy?: boolean;
  showDownload?: boolean;
  showFullscreen?: boolean;
  accept?: string;
}

const {
  locale,
  action = 'format',
  label = t(locale, 'tool.format'),
  showIndent = true,
  showFind = true,
  showCopy = true,
  showDownload = true,
  showFullscreen = false,
  accept = '.json,.txt,.geojson,application/json,text/plain',
} = Astro.props;
const indentOptions = [
  { value: '2', label: t(locale, 'tool.indent.2') },
  { value: '4', label: t(locale, 'tool.indent.4') },
  { value: 'tab', label: t(locale, 'tool.indent.tab') },
];
const labels = {
  sample: t(locale, 'tool.sample'),
  find: t(locale, 'tool.find'),
  open: t(locale, 'tool.open'),
  paste: t(locale, 'tool.paste'),
  copy: t(locale, 'tool.copy'),
  download: t(locale, 'tool.download'),
  clear: t(locale, 'tool.clear'),
  help: t(locale, 'tool.shortcuts'),
  fullscreen: t(locale, 'tool.fullscreen'),
  exitFullscreen: t(locale, 'tool.exitFullscreen'),
};
---

<div
  class="flex flex-wrap items-center gap-2 border-b border-line px-3 py-3 sm:px-4"
  role="group"
  aria-label={t(locale, 'tool.actions')}
>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-action={action}
      aria-keyshortcuts="Control+Enter Meta+Enter"
      class="inline-flex h-11 items-center gap-2 rounded-[8px] bg-primary px-4 text-[15px] font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-50"
    >
      <Icon name="play" class="size-4" />
      <span>{label}</span>
    </button>

    <button type="button" data-action="sample" class="ghost-button">
      {labels.sample}
    </button>

    {
      showIndent && (
        <div class="relative h-11 rounded-[8px] border border-line" data-select>
          <button
            type="button"
            data-select-trigger
            aria-haspopup="listbox"
            aria-expanded="false"
            class="flex h-full items-center gap-2 rounded-[8px] px-3 text-[14px] text-ink"
          >
            <span id="tool-indent-label" class="sr-only text-[13px] text-body-mid sm:not-sr-only">
              {t(locale, 'tool.indent')}
            </span>
            <span data-select-value>{indentOptions[0].label}</span>
            <Icon name="chevron-down" class="size-3.5 shrink-0 text-body-mid" />
          </button>

          <ul
            id="tool-indent-list"
            data-select-list
            role="listbox"
            tabindex="-1"
            aria-labelledby="tool-indent-label"
            hidden
            class="absolute left-0 top-full z-50 mt-2 w-44 rounded-[10px] border border-line bg-canvas p-1 shadow-[var(--shadow-1)]"
          >
            {indentOptions.map((option) => (
              <li
                role="option"
                data-value={option.value}
                aria-selected={option.value === '2' ? 'true' : 'false'}
                class="indent-option"
              >
                <span data-select-label>{option.label}</span>
                <span class="indent-check"><Icon name="check" class="size-4 text-primary" /></span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="ms-auto flex flex-wrap items-center gap-0.5">
    {
      showFind && (
        <button
          type="button"
          data-action="find"
          class="icon-button"
          aria-label={labels.find}
          title={labels.find}
          aria-keyshortcuts="Control+F Meta+F"
        >
          <Icon name="search" class="size-[18px]" />
        </button>
      )
    }
    <button type="button" data-action="open" class="icon-button" aria-label={labels.open} title={labels.open}>
      <Icon name="folder" class="size-[18px]" />
    </button>
    <button type="button" data-action="paste" class="icon-button" aria-label={labels.paste} title={labels.paste}>
      <Icon name="clipboard" class="size-[18px]" />
    </button>
    {
      showCopy && (
        <button
          type="button"
          data-action="copy"
          class="icon-button"
          aria-label={labels.copy}
          title={labels.copy}
          aria-keyshortcuts="Control+Shift+C Meta+Shift+C"
          disabled
        >
          <Icon name="copy" class="size-[18px]" />
        </button>
      )
    }
    {
      showDownload && (
        <button
          type="button"
          data-action="download"
          class="icon-button"
          aria-label={labels.download}
          title={labels.download}
          disabled
        >
          <Icon name="download" class="size-[18px]" />
        </button>
      )
    }
    <button type="button" data-action="clear" class="icon-button" aria-label={labels.clear} title={labels.clear} disabled>
      <Icon name="trash" class="size-[18px]" />
    </button>
    <button type="button" data-action="help" class="icon-button" aria-label={labels.help} title={labels.help}>
      <Icon name="help" class="size-[18px]" />
    </button>
    {
      showFullscreen && (
        <button
          type="button"
          data-action="fullscreen"
          class="icon-button"
          aria-label={labels.fullscreen}
          title={labels.fullscreen}
          aria-pressed="false"
        >
          <span data-fullscreen-enter>
            <Icon name="maximize" class="size-[18px]" />
          </span>
          <span data-fullscreen-exit hidden>
            <Icon name="minimize" class="size-[18px]" />
          </span>
        </button>
      )
    }
  </div>

  <input type="file" data-file-input accept={accept} class="hidden" tabindex="-1" />
</div>

<style>
  .indent-option {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-radius: 6px;
    padding: 0 10px;
    font-size: 14px;
    color: var(--body);
    cursor: pointer;
  }

  .indent-option[data-active='true'] {
    background: var(--cream);
  }

  .indent-option:hover {
    background: var(--cream);
  }

  .indent-option[aria-selected='true'] {
    color: var(--ink);
  }

  .indent-check {
    display: flex;
    flex: none;
    opacity: 0;
  }

  .indent-option[aria-selected='true'] .indent-check {
    opacity: 1;
  }

  .ghost-button {
    display: inline-flex;
    height: 44px;
    align-items: center;
    border-radius: 8px;
    padding: 0 12px;
    font-size: 14px;
    color: var(--ink);
  }

  .ghost-button:hover {
    background: var(--cream);
  }

  .icon-button {
    display: inline-flex;
    height: 44px;
    width: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--ink);
  }

  .icon-button:hover {
    background: var(--cream);
  }

  .icon-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }
</style>
