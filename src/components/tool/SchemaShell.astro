---
import ToolPage from './ToolPage.astro';
import Toolbar from './Toolbar.astro';
import EditorPane from './EditorPane.astro';
import StatsBar from './StatsBar.astro';
import ShortcutsDialog from './ShortcutsDialog.astro';
import type { Locale } from '../../i18n/config';
import type { ToolDef } from '../../tools/types';
import { t } from '../../i18n/t';
import { commonToolStrings } from '../../i18n/tool-strings';

interface Props {
  locale: Locale;
  tool: ToolDef;
}

const { locale, tool } = Astro.props;
const runLabel = t(locale, 'tool.run');
const paneOpen = t(locale, 'tool.open');

const stats = [
  { key: 'schemaSize', label: t(locale, 'tool.schema') },
  { key: 'documentSize', label: t(locale, 'tool.document') },
  { key: 'checked', label: t(locale, 'tool.schema.checks') },
  { key: 'errors', label: t(locale, 'tool.schema.errors') },
  { key: 'time', label: t(locale, 'tool.stats.time') },
];

const strings = {
  ...commonToolStrings(locale),
  largeRun: t(locale, 'tool.largeRunAction', { action: runLabel }),
  largeLoaded: t(locale, 'tool.largeLoadedAction', { action: runLabel }),
  largeWarning: t(locale, 'tool.largeWarningAction', { action: runLabel }),
  runLabel,
  validating: t(locale, 'tool.validating'),
  validTitle: t(locale, 'tool.schema.validTitle'),
  invalidTitle: t(locale, 'tool.schema.invalidTitle'),
  needBoth: t(locale, 'tool.schema.needBoth'),
  schemaPane: t(locale, 'tool.schema'),
  documentPane: t(locale, 'tool.document'),
  schemaPlaceholder: t(locale, 'tool.schema.placeholder'),
  documentPlaceholder: t(locale, 'tool.document.placeholder'),
  schemaLabel: t(locale, 'tool.schema.label'),
  documentLabel: t(locale, 'tool.document.label'),
  checks: t(locale, 'tool.schema.checks'),
  errors: t(locale, 'tool.schema.errors'),
  reportTitle: t(locale, 'tool.schema.reportTitle'),
  reportValid: t(locale, 'tool.schema.reportValid'),
  reportInvalid: t(locale, 'tool.schema.reportInvalid'),
  reportChecked: t(locale, 'tool.schema.reportChecked'),
  reportTime: t(locale, 'tool.schema.reportTime'),
  reportErrors: t(locale, 'tool.schema.reportErrors'),
  reportProblems: t(locale, 'tool.schema.reportProblems'),
  reportUnsupported: t(locale, 'tool.schema.reportUnsupported'),
  parseSchema: t(locale, 'tool.schema.parseSchema'),
  parseDocument: t(locale, 'tool.schema.parseDocument'),
  parseGeneric: t(locale, 'tool.schema.parseGeneric'),
  unsupportedHint: t(locale, 'tool.schema.unsupportedHint'),
  allSupported: t(locale, 'tool.schema.allSupported'),
  noErrors: t(locale, 'tool.schema.noErrors'),
  truncated: t(locale, 'tool.schema.truncated'),
  validDone: t(locale, 'tool.schema.validDone'),
  invalidDone: t(locale, 'tool.schema.invalidDone'),
  validAnnounce: t(locale, 'tool.schema.validAnnounce'),
  invalidAnnounce: t(locale, 'tool.schema.invalidAnnounce'),
  inputLabel: t(locale, 'tool.schema.label'),
  outputLabel: t(locale, 'tool.document.label'),
};
---

<ToolPage locale={locale} tool={tool} strings={strings}>
  <div
    class="mt-5 overflow-hidden rounded-[16px] border border-line bg-canvas sm:mt-7"
    data-tool-frame
  >
    <Toolbar
      locale={locale}
      action="validateSchema"
      label={runLabel}
      showIndent={false}
      showFind={true}
      showFullscreen
      accept=".json,.txt,.schema,application/json,text/plain"
    />

    <div
      class="flex items-center gap-1 border-b border-line px-2 md:hidden"
      role="tablist"
      aria-label={`${t(locale, 'tool.schema')} / ${t(locale, 'tool.document')}`}
      data-mobile-tabs
    >
      <button
        type="button"
        id="tab-schema"
        data-tab="left"
        role="tab"
        aria-selected="true"
        aria-controls="pane-schema"
        tabindex="0"
        class="tool-tab"
      >
        {t(locale, 'tool.schema')}
      </button>
      <button
        type="button"
        id="tab-document"
        data-tab="right"
        role="tab"
        aria-selected="false"
        aria-controls="pane-document"
        tabindex="-1"
        class="tool-tab"
      >
        {t(locale, 'tool.document')}
      </button>
    </div>

    <div class="tool-panes md:grid md:grid-cols-2" data-mobile-view="left">
      <section
        class="tool-pane is-active flex min-w-0 flex-col"
        data-pane="left"
        id="pane-schema"
        role="tabpanel"
        aria-label={t(locale, 'tool.schema')}
      >
        <div class="pane-head">
          <h2 class="whitespace-nowrap font-sans text-[12px] font-semibold uppercase leading-5 tracking-[0.08em] text-body-mid">
            {t(locale, 'tool.schema')}
          </h2>
          <button type="button" data-open-side="schema" class="pane-open">{paneOpen}</button>
        </div>

        <EditorPane
          kind="left"
          locale={locale}
          largeAction="schema-large"
          largeLabel={t(locale, 'tool.schema.runSchemaFile')}
        >
        </EditorPane>
      </section>

      <section
        class="tool-pane flex min-w-0 flex-col md:border-l md:border-line"
        data-pane="right"
        id="pane-document"
        role="tabpanel"
        aria-label={t(locale, 'tool.document')}
      >
        <div class="pane-head">
          <h2 class="whitespace-nowrap font-sans text-[12px] font-semibold uppercase leading-5 tracking-[0.08em] text-body-mid">
            {t(locale, 'tool.document')}
          </h2>
          <button type="button" data-open-side="document" class="pane-open">{paneOpen}</button>
        </div>

        <EditorPane
          kind="right"
          locale={locale}
          largeAction="document-large"
          largeLabel={t(locale, 'tool.schema.runDocumentFile')}
        >
        </EditorPane>
      </section>
    </div>

    <section
      class="border-t border-line"
      data-report
      aria-labelledby="schema-report-title"
      hidden
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2 px-3 pb-2 pt-4 sm:px-4">
        <h2 id="schema-report-title" class="text-[17px] font-semibold leading-6 text-ink" data-report-title />
        <p class="font-mono text-[12px] leading-5 text-body-mid" data-report-summary />
      </div>

      <div class="px-3 pb-4 sm:px-4">
        <div class="rounded-[10px] border border-danger/40 bg-danger/5 p-3" data-parse-error hidden>
          <h3 class="text-[14px] font-semibold leading-5 text-ink" data-parse-title />
          <p class="mt-1 break-words font-mono text-[13px] leading-5 text-ink" data-error-message />
          <p class="mt-1 text-[13px] leading-5 text-danger" data-error-location hidden />
          <p class="mt-1 text-[14px] leading-6 text-body" data-error-hint />
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" data-error-goto class="report-button">{t(locale, 'tool.errorGoto')}</button>
            <button type="button" data-error-dismiss class="report-quiet">{t(locale, 'tool.errorDismiss')}</button>
          </div>
        </div>

        <div data-report-errors hidden>
          <h3 class="text-[13px] font-semibold uppercase leading-5 tracking-[0.06em] text-body-mid">
            {t(locale, 'tool.schema.errors')}
          </h3>
          <ul class="mt-2 space-y-2" data-error-list />
          <p class="mt-2 text-[13px] leading-5 text-body-mid" data-truncated hidden>
            {t(locale, 'tool.schema.truncated')}
          </p>
        </div>

        <div data-report-problems hidden>
          <h3 class="mt-4 text-[13px] font-semibold uppercase leading-5 tracking-[0.06em] text-body-mid">
            {t(locale, 'tool.schema.problems')}
          </h3>
          <ul class="mt-2 space-y-2" data-problem-list />
        </div>

        <div data-report-unsupported hidden>
          <h3 class="mt-4 text-[13px] font-semibold uppercase leading-5 tracking-[0.06em] text-body-mid">
            {t(locale, 'tool.schema.unsupported')}
          </h3>
          <p class="mt-1 text-[13px] leading-5 text-body-mid" data-unsupported-hint />
          <ul class="mt-2 flex flex-wrap gap-2" data-unsupported-list />
          <p class="mt-1 text-[13px] leading-5 text-body-mid" data-unsupported-none hidden>
            {t(locale, 'tool.schema.allSupported')}
          </p>
        </div>
      </div>
    </section>

    <StatsBar locale={locale} stats={stats} />
  </div>
</ToolPage>

<ShortcutsDialog locale={locale} runLabel={runLabel} />

<style>
  .tool-tab {
    position: relative;
    display: inline-flex;
    height: 44px;
    align-items: center;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--body-mid);
  }

  .tool-tab[aria-selected="true"] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--primary);
  }

  .pane-open {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 8px;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--body-mid);
  }

  .pane-open:hover {
    background: var(--cream);
    color: var(--ink);
  }

  .report-button {
    display: inline-flex;
    height: 40px;
    align-items: center;
    border-radius: 9px;
    background: var(--ink);
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--canvas);
  }

  .report-quiet {
    display: inline-flex;
    height: 40px;
    align-items: center;
    border-radius: 9px;
    padding: 0 12px;
    font-size: 14px;
    color: var(--ink);
  }

  .report-quiet:hover {
    background: var(--cream);
  }

  @media (max-width: 767px) {
    .tool-pane {
      display: none;
    }

    .tool-pane.is-active {
      display: flex;
    }
  }
</style>
