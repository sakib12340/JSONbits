---
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="absolute inset-0 z-20 overflow-auto bg-canvas p-4 sm:p-5"
  data-error-panel
  role="region"
  aria-labelledby="tool-error-title"
  hidden
>
  <div class="flex items-start gap-3">
    <span
      class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-danger font-mono text-[14px] leading-none text-danger"
      aria-hidden="true"
    >
      !
    </span>
    <div class="min-w-0 flex-1">
      <h3 id="tool-error-title" class="text-[15px] font-semibold leading-6 text-ink">
        {t(locale, 'tool.errorTitle')}
      </h3>
      <p
        class="mt-1 break-words font-mono text-[13px] leading-5 text-ink"
        data-error-message
      ></p>
      <p class="mt-2 text-[13px] leading-5 text-danger" data-error-location hidden></p>
      <p class="mt-1 text-[14px] leading-6 text-body" data-error-hint></p>
      <pre
        class="mt-3 hidden overflow-x-auto rounded-[8px] border border-line bg-cream p-3 font-mono text-[12px] leading-5 text-body"
        data-error-snippet
      ><code></code></pre>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" data-error-goto class="error-primary">
          <Icon name="play" class="size-3.5" />
          <span data-error-goto-label>{t(locale, 'tool.errorGoto')}</span>
        </button>
        <button type="button" data-error-dismiss class="error-secondary">
          {t(locale, 'tool.errorDismiss')}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .error-primary {
    display: inline-flex;
    height: 40px;
    align-items: center;
    gap: 6px;
    border-radius: 9px;
    background: var(--ink);
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--canvas);
  }

  .error-secondary {
    display: inline-flex;
    height: 40px;
    align-items: center;
    border-radius: 9px;
    padding: 0 12px;
    font-size: 14px;
    color: var(--ink);
  }

  .error-secondary:hover {
    background: var(--cream);
  }
</style>
