---
import ToolPage from './ToolPage.astro';
import Toolbar from './Toolbar.astro';
import EditorPane from './EditorPane.astro';
import FileDropzone from './FileDropzone.astro';
import StatsBar from './StatsBar.astro';
import ShortcutsDialog from './ShortcutsDialog.astro';
import type { Locale } from '../../i18n/config';
import type { ToolDef } from '../../tools/types';
import { t } from '../../i18n/t';
import { commonToolStrings } from '../../i18n/tool-strings';

interface Props {
  locale: Locale;
  tool: ToolDef;
}

const { locale, tool } = Astro.props;
const action = t(locale, 'tool.validate');
const strings = {
  ...commonToolStrings(locale),
  largeRun: t(locale, 'tool.largeRunAction', { action }),
  largeLoaded: t(locale, 'tool.largeLoadedAction', { action }),
  largeWarning: t(locale, 'tool.largeWarningAction', { action }),
  validating: t(locale, 'tool.validating'),
  validateFile: t(locale, 'tool.validateFile'),
  validTitle: t(locale, 'tool.validTitle'),
  validDetail: t(locale, 'tool.validDetail'),
  invalidTitle: t(locale, 'tool.invalidTitle'),
  validDone: t(locale, 'tool.validDone'),
  invalidDone: t(locale, 'tool.invalidDone'),
  validAnnounce: t(locale, 'tool.validAnnounce'),
};
---

<ToolPage locale={locale} tool={tool} strings={strings}>
  <div
    class="mt-5 overflow-hidden rounded-[16px] border border-line bg-canvas sm:mt-7"
    data-tool-frame
  >
    <Toolbar
      locale={locale}
      action="validate"
      label={t(locale, 'tool.validate')}
      showIndent={false}
      showCopy={false}
      showDownload={false}
      showFind={true}
    />

    <section
      class="min-w-0"
      aria-label={t(locale, 'tool.input')}
    >
      <div class="flex min-h-[46px] flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-2">
        <h2 class="font-sans text-[12px] font-semibold uppercase leading-5 tracking-[0.08em] text-body-mid">
          {t(locale, 'tool.input')}
        </h2>
        <span
          data-file-chip
          hidden
          class="inline-flex max-w-[60%] items-center gap-1.5 rounded-full bg-cream px-2.5 py-1 font-mono text-[11px] leading-4 text-body"
        >
          <span data-file-name class="truncate" />
        </span>
      </div>

      <EditorPane
        kind="input"
        locale={locale}
        largeAction="validate-large"
        largeLabel={t(locale, 'tool.validateFile')}
      >
        <FileDropzone locale={locale} />
      </EditorPane>
    </section>

    <div
      class="border-t border-line px-4 py-4 sm:px-5"
      data-result
      aria-live="polite"
      hidden
    >
      <div class="flex items-start gap-3" data-result-valid hidden>
        <span
          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-success font-mono text-[15px] leading-none text-success"
          aria-hidden="true"
        >
          ✓
        </span>
        <div class="min-w-0">
          <h2 class="text-[16px] font-semibold leading-6 text-ink">
            {t(locale, 'tool.validTitle')}
          </h2>
          <p class="mt-1 text-[14px] leading-6 text-body" data-valid-detail></p>
        </div>
      </div>

      <div class="flex items-start gap-3" data-result-invalid hidden>
        <span
          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-danger font-mono text-[15px] leading-none text-danger"
          aria-hidden="true"
        >
          !
        </span>
        <div class="min-w-0 flex-1">
          <h2 class="text-[16px] font-semibold leading-6 text-ink">
            {t(locale, 'tool.invalidTitle')}
          </h2>
          <p
            class="mt-1 break-words font-mono text-[13px] leading-5 text-ink"
            data-error-message
          ></p>
          <p class="mt-2 text-[13px] leading-5 text-danger" data-error-location hidden></p>
          <p class="mt-1 text-[14px] leading-6 text-body" data-error-hint></p>
          <pre
            class="mt-3 hidden overflow-x-auto rounded-[8px] border border-line bg-cream p-3 font-mono text-[12px] leading-5 text-body"
            data-error-snippet
          ><code></code></pre>
          <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-error-goto class="error-primary">
              {t(locale, 'tool.errorGoto')}
            </button>
            <button type="button" data-error-dismiss class="error-secondary">
              {t(locale, 'tool.errorDismiss')}
            </button>
          </div>
        </div>
      </div>
    </div>

    <StatsBar locale={locale} />
  </div>
</ToolPage>

<ShortcutsDialog locale={locale} runLabel={t(locale, 'tool.validate')} />

<style>
  .error-primary {
    display: inline-flex;
    height: 40px;
    align-items: center;
    border-radius: 9px;
    background: var(--ink);
    padding: 0 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--canvas);
  }

  .error-secondary {
    display: inline-flex;
    height: 40px;
    align-items: center;
    border-radius: 9px;
    padding: 0 12px;
    font-size: 14px;
    color: var(--ink);
  }

  .error-secondary:hover {
    background: var(--cream);
  }
</style>
