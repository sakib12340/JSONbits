---
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const targets = [
  { slug: 'json-formatter', label: t(locale, 'tool.jsonpath.sendFormatter') },
  { slug: 'json-to-csv', label: t(locale, 'tool.jsonpath.sendCsv') },
  { slug: 'json-to-json-schema', label: t(locale, 'tool.jsonpath.sendSchema') },
];
---

<div
  data-output-actions
  hidden
  class="flex flex-wrap items-center gap-2 border-b border-line px-3 py-2 text-[12px] text-body-mid"
>
  <details class="relative inline-flex items-center" data-output-send-menu>
    <summary
      class="inline-flex min-h-[32px] cursor-pointer list-none items-center gap-1.5 rounded-[8px] px-2 text-[12px] font-semibold leading-5 text-body-mid hover:bg-cream hover:text-ink"
      aria-label={t(locale, 'tool.jsonpath.sendOutput')}
      title={t(locale, 'tool.jsonpath.sendOutput')}
    >
      <Icon name="arrow-right" class="size-4" />
      <span>{t(locale, 'tool.jsonpath.sendOutput')}</span>
    </summary>
    <div class="menu-panel">
      <p class="menu-heading">{t(locale, 'tool.send.heading')}</p>
      {
        targets.map((target) => (
          <button
            type="button"
            class="menu-item"
            data-output-send
            data-send-slug={target.slug}
          >
            {target.label}
          </button>
        ))
      }
    </div>
  </details>

  <button
    type="button"
    data-download-all
    hidden
    class="min-h-11 rounded-md border border-line px-2.5 hover:border-line-strong hover:text-ink"
  >
    {t(locale, 'tool.jsonpath.downloadAll')}
  </button>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  [data-output-send-menu] .menu-panel {
    width: 13rem;
  }

  @media (pointer: coarse) {
    summary {
      min-height: 44px;
    }
  }
</style>

<script>
  import { positionPopover } from '../../lib/popover';

  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-output-send-menu]')) {
    const summary = menu.querySelector('summary');
    const panel = menu.querySelector<HTMLElement>('.menu-panel');
    if (summary && panel) {
      const update = (): void => {
        if (menu.open) positionPopover(summary, panel);
      };
      menu.addEventListener('toggle', update);
      window.addEventListener('resize', update);
    }

    menu.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-output-send]');
      if (!target) return;
      event.preventDefault();
      menu.removeAttribute('open');
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      event.preventDefault();
      menu.removeAttribute('open');
      menu.querySelector('summary')?.focus();
    });
  }

  document.addEventListener('pointerdown', (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-output-send-menu]')) {
      if (!menu.open) continue;
      if (event.target instanceof Node && menu.contains(event.target)) continue;
      menu.removeAttribute('open');
    }
  });
</script>
