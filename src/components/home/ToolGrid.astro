---
import Icon from '../ui/Icon.astro';
import ToolCard from './ToolCard.astro';
import { tools } from '../../tools/registry';
import { toolCategories, type ToolCategory } from '../../tools/types';
import type { Locale } from '../../i18n/config';
import { localePath } from '../../lib/paths';
import { hubByCategory } from '../../lib/categories';
import { toolDescription } from '../../i18n/tool-text';
import { t, type TranslationKey } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const categoryKeys = {
  format: { name: 'category.format', description: 'category.format.description' },
  validate: { name: 'category.validate', description: 'category.validate.description' },
  view: { name: 'category.view', description: 'category.view.description' },
  convert: { name: 'category.convert', description: 'category.convert.description' },
  compare: { name: 'category.compare', description: 'category.compare.description' },
  generate: { name: 'category.generate', description: 'category.generate.description' },
} as const satisfies Record<ToolCategory, { name: TranslationKey; description: TranslationKey }>;

const groups = toolCategories
  .map((category) => ({
    category,
    items: tools.filter((tool) => tool.category === category),
  }))
  .filter((group) => group.items.length > 0);

const total = tools.length;
const resultsTemplate = t(locale, 'home.search.results');
const availableCategories = new Set(
  tools.filter((tool) => tool.available).map((tool) => tool.category),
);
---

<section
  id="tools"
  class="scroll-mt-24 border-y border-line bg-cream"
  aria-labelledby="tools-heading"
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2
          id="tools-heading"
          class="text-[32px] font-medium leading-[1.05] tracking-[-0.03em] text-ink sm:text-[44px]"
        >
          {t(locale, 'home.tools.title')}
        </h2>
        <p class="mt-3 max-w-xl text-[16px] leading-[26px] text-body">
          {t(locale, 'home.tools.intro')}
        </p>
      </div>

      <form
        role="search"
        class="w-full lg:max-w-sm"
        data-tool-search
        data-results-template={resultsTemplate}
      >
        <label for="tool-search" class="sr-only">{t(locale, 'home.search.label')}</label>
        <div class="group relative">
          <Icon
            name="search"
            class="pointer-events-none absolute left-3.5 top-1/2 size-[18px] -translate-y-1/2 text-body-mid"
          />
          <input
            id="tool-search"
            type="search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            placeholder={t(locale, 'home.search.placeholder')}
            aria-keyshortcuts="/"
            aria-describedby="tool-search-status"
            class="h-11 w-full rounded-[6px] border border-line bg-canvas pl-11 pr-12 text-[15px] text-ink placeholder:text-body-mid focus:border-ink focus:outline-none"
          />
          <kbd
            class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded-[4px] border border-line bg-cream px-1.5 py-1 font-mono text-[11px] leading-none text-body-mid transition-opacity group-focus-within:opacity-0 sm:block"
            aria-hidden="true">/</kbd>
        </div>
        <p
          id="tool-search-status"
          data-search-status
          role="status"
          aria-live="polite"
          class="mt-3 text-[13px] leading-5 text-body-mid"
        >
          {t(locale, 'home.search.results', { count: total, total })}
        </p>
      </form>
    </div>

    <div class="mt-12 flex flex-col gap-14">
      {
        groups.map(({ category, items }) => {
          const keys = categoryKeys[category];
          const hub = hubByCategory(category);
          const hubHref = localePath(locale, `/${hub.slug}`);
          const hasHub = availableCategories.has(category);

          return (
            <section data-tool-section aria-labelledby={`category-${category}`}>
              <div class="flex flex-col gap-2 border-t border-line pt-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <h3
                  id={`category-${category}`}
                  class="text-[20px] font-semibold leading-[26px] tracking-[-0.015em] text-ink"
                >
                  {hasHub ? (
                    <a
                      href={hubHref}
                      class="inline-flex items-center gap-1.5 rounded-[4px] underline-offset-4 hover:underline"
                    >
                      {t(locale, keys.name)}
                      <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    t(locale, keys.name)
                  )}
                </h3>
                <p class="text-[14px] leading-[22px] text-body-mid">{t(locale, keys.description)}</p>
              </div>
              <ul class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
                {items.map((tool) => (
                  <li
                    class="min-w-0"
                    data-tool-card
                    data-search={`${tool.name} ${toolDescription(locale, tool)} ${tool.keywords.join(' ')}`.toLowerCase()}
                  >
                    <ToolCard
                      tool={tool}
                      locale={locale}
                      href={localePath(locale, `/${tool.slug}`)}
                    />
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>

    <div
      data-search-empty
      hidden
      class="mt-12 rounded-[12px] border border-line bg-canvas px-6 py-16 text-center"
    >
      <p class="text-[16px] leading-[26px] text-body">{t(locale, 'home.search.empty')}</p>
      <button
        type="button"
        data-search-clear
        hidden
        class="mt-6 inline-flex h-11 items-center rounded-[8px] border border-ink px-5 text-[15px] font-semibold text-ink hover:bg-cream"
      >
        {t(locale, 'home.search.clear')}
      </button>
    </div>
  </div>
</section>
