---
import type { Locale } from '../../i18n/config';
import type { ToolDef } from '../../tools/types';
import { t } from '../../i18n/t';

interface Props {
  tool: ToolDef;
  locale: Locale;
  href: string;
}

const { tool, locale, href } = Astro.props;
const Tag = tool.available ? 'a' : 'div';
---

<Tag
  href={tool.available ? href : undefined}
  class:list={[
    'flex h-full min-w-0 flex-col rounded-[12px] border border-line bg-canvas p-6',
    tool.available && 'transition-colors hover:border-line-strong',
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h4 class="text-[18px] font-semibold leading-[27px] text-ink">{tool.name}</h4>
    {
      !tool.available && (
        <span class="shrink-0 rounded-full bg-cream px-3 py-1.5 text-[14px] font-medium uppercase leading-none tracking-[0.06em] text-body-mid">
          {t(locale, 'home.tools.soon')}
        </span>
      )
    }
  </div>
  <p class="mt-2 text-base leading-6 text-body">{tool.description}</p>
</Tag>
