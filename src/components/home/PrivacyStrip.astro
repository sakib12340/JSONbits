---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = [
  {
    number: '01',
    title: t(locale, 'home.privacy.local.title'),
    body: t(locale, 'home.privacy.local.body'),
  },
  {
    number: '02',
    title: t(locale, 'home.privacy.upload.title'),
    body: t(locale, 'home.privacy.upload.body'),
  },
  {
    number: '03',
    title: t(locale, 'home.privacy.tracking.title'),
    body: t(locale, 'home.privacy.tracking.body'),
  },
];
---

<section
  aria-labelledby="privacy-heading"
  class="bg-signature text-signature-text"
  data-signature-band
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div
      class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16"
    >
      <h2
        id="privacy-heading"
        class="max-w-md text-balance text-[32px] font-medium leading-[1.05] tracking-[-0.03em] text-signature-text sm:text-[44px]"
      >
        {t(locale, 'home.privacy.title')}
      </h2>
      <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
        {
          items.map((item) => (
            <div class="border-t border-signature-line pt-5">
              <span
                class="font-mono text-[12px] leading-none tracking-[0.08em] text-signature-accent"
                aria-hidden="true"
              >
                {item.number}
              </span>
              <h3 class="mt-3 text-[16px] font-semibold leading-[22px] text-signature-text">
                {item.title}
              </h3>
              <p class="mt-1.5 text-[14px] leading-[22px] text-signature-body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
