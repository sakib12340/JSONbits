---
import BrandMark from '../ui/BrandMark.astro';
import type { Locale } from '../../i18n/config';
import { localePath } from '../../lib/paths';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-canvas">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a
          href={localePath(locale, '/')}
          class="inline-flex min-h-11 items-center gap-2.5 rounded-[8px] text-ink"
        >
          <BrandMark class="size-7 text-primary" />
          <span class="text-[17px] font-semibold tracking-[-0.015em]">{t(locale, 'site.name')}</span>
        </a>
        <p class="mt-3 max-w-sm text-[14px] leading-[22px] text-body">
          {t(locale, 'footer.tagline')}
        </p>
      </div>
      <div class="flex flex-col gap-5 sm:items-end">
        <nav aria-label={t(locale, 'footer.nav')} class="flex flex-wrap gap-x-5 gap-y-1 sm:justify-end">
          <a
            href={`${localePath(locale, '/')}#tools`}
            class="inline-flex min-h-11 items-center text-[14px] font-medium text-ink hover:underline hover:underline-offset-4"
          >
            {t(locale, 'footer.tools')}
          </a>
          <a
            href={localePath(locale, '/learn')}
            class="inline-flex min-h-11 items-center text-[14px] font-medium text-ink hover:underline hover:underline-offset-4"
          >
            {t(locale, 'footer.learn')}
          </a>
          <a
            href={localePath(locale, '/privacy')}
            class="inline-flex min-h-11 items-center text-[14px] font-medium text-ink hover:underline hover:underline-offset-4"
          >
            {t(locale, 'footer.privacy')}
          </a>
        </nav>
        <p class="max-w-sm text-[14px] leading-[22px] text-body">
          {t(locale, 'home.privacy')}
        </p>
      </div>
    </div>
    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[12px] leading-5 text-body-mid">
        {t(locale, 'footer.copyright', { year })}
      </p>
      <p class="text-[12px] leading-5 text-body-mid">
        {t(locale, 'home.privacy.local.title')}
      </p>
    </div>
  </div>
</footer>
