---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../seo/JsonLd.astro';
import type { Locale } from '../../i18n/config';
import { listGuides } from '../../lib/content';
import { localePath } from '../../lib/paths';
import { localeUrl } from '../../lib/site';
import { collectionPageSchema } from '../../lib/schema';
import { t } from '../../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const guides = await listGuides(locale);
const url = localeUrl(locale, '/learn');
const description = t(locale, 'learn.description');
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' });

const structuredData = collectionPageSchema({
  name: t(locale, 'learn.title'),
  description,
  url,
  locale,
  items: guides.map((guide) => ({
    name: guide.data.title,
    url: localeUrl(locale, `/learn/${guide.data.slug}`),
  })),
});
---

<BaseLayout locale={locale} title={t(locale, 'learn.metaTitle')} description={description} path="/learn">
  <JsonLd slot="head" data={structuredData} />

  <div class="mx-auto max-w-4xl px-4 pb-20 pt-8 sm:px-6 sm:pt-10">
    <header class="max-w-2xl">
      <h1
        class="text-[32px] font-medium leading-[1.05] tracking-[-0.03em] text-ink sm:text-[44px]"
      >
        {t(locale, 'learn.title')}
      </h1>
      <p class="mt-4 text-[16px] leading-[26px] text-body">{t(locale, 'learn.intro')}</p>
    </header>

    <ul class="mt-10 grid gap-4">
      {
        guides.map((guide) => (
          <li class="min-w-0">
            <article class="relative rounded-[12px] border border-line bg-canvas p-6 transition-[border-color,box-shadow] hover:border-line-strong hover:shadow-[var(--shadow-1)] sm:p-7">
              <h2 class="text-[20px] font-semibold leading-[26px] tracking-[-0.015em] text-ink">
                <a
                  href={localePath(locale, `/learn/${guide.data.slug}`)}
                  class="after:absolute after:inset-0"
                >
                  {guide.data.title}
                </a>
              </h2>
              <p class="mt-2 text-[15px] leading-[25px] text-body">{guide.data.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] leading-5 text-body-mid">
                <time datetime={guide.data.updated.toISOString()}>
                  {t(locale, 'guide.updated', { date: dateFormat.format(guide.data.updated) })}
                </time>
                <span aria-hidden="true">{t(locale, 'learn.read')} →</span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 border-t border-line pt-6 text-[13px] leading-[22px] text-body-mid">
      {t(locale, 'article.privacy')}
    </p>
  </div>
</BaseLayout>
