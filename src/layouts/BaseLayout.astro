---
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import { localeMeta, type Locale } from '../i18n/config';
import { t } from '../i18n/t';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Path inside the locale, no trailing slash. */
  path: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Override the path used by the language switcher. */
  langPath?: string;
}

const { title, description, locale, path, type, noindex, langPath } = Astro.props;
const meta = localeMeta[locale];
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir} data-theme="light" data-theme-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fffefb" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = 'light';

        try {
          if (localStorage.getItem('theme') === 'dark') theme = 'dark';
        } catch {}

        root.dataset.theme = theme;
        root.dataset.themeMode = theme;

        const color = document.querySelector('meta[name="theme-color"]');
        if (color) color.setAttribute('content', theme === 'dark' ? '#0a0f0e' : '#fffefb');
      })();
    </script>
    <SEOHead title={title} description={description} locale={locale} path={path} type={type} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-body antialiased">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-[12px] focus:border focus:border-line focus:bg-canvas focus:px-5 focus:py-3 focus:text-base focus:text-ink"
      href="#main-content"
    >
      {t(locale, 'a11y.skipToContent')}
    </a>
    <Header locale={locale} langPath={langPath} />
    <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../lib/theme';
      import '../lib/lang-menu';
    </script>
  </body>
</html>
